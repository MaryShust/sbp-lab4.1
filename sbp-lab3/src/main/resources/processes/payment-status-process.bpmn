<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="payment-status-process" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_Start_To_CheckPrivilege</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_CheckPrivilege"
                       sourceRef="StartEvent_1"
                       targetRef="Activity_CheckPrivilege" />

    <bpmn:serviceTask id="Activity_CheckPrivilege"
                      name="Check Payment Status Privilege"
                      camunda:class="com.example.sbp.delegate.CheckPrivilegeReadPaymentStatusDelegate"
                      camunda:asyncBefore="true"
                      camunda:asyncAfter="true">
      <bpmn:incoming>Flow_Start_To_CheckPrivilege</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPrivilege_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_CheckPrivilege_To_Gateway"
                       sourceRef="Activity_CheckPrivilege"
                       targetRef="Gateway_AfterCheckPrivilege" />

    <bpmn:exclusiveGateway id="Gateway_AfterCheckPrivilege" name="Успех?">
      <bpmn:incoming>Flow_CheckPrivilege_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPrivilege_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckPrivilege_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_CheckPrivilege_Success"
                       sourceRef="Gateway_AfterCheckPrivilege"
                       targetRef="Activity_GetStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        <![CDATA[${hasPrivilege == true}]]>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CheckPrivilege_Error"
                       sourceRef="Gateway_AfterCheckPrivilege"
                       targetRef="ErrorEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        <![CDATA[${hasPrivilege == false}]]>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Activity_GetStatus"
                      name="Get Transaction Status"
                      camunda:class="com.example.sbp.delegate.GetTransactionStatusDelegate"
                      camunda:asyncBefore="true"
                      camunda:asyncAfter="true">
      <bpmn:incoming>Flow_CheckPrivilege_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_GetStatus_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_GetStatus_To_Gateway"
                       sourceRef="Activity_GetStatus"
                       targetRef="Gateway_AfterGetStatus" />

    <bpmn:exclusiveGateway id="Gateway_AfterGetStatus" name="Успех?">
      <bpmn:incoming>Flow_GetStatus_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GetStatus_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_GetStatus_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_GetStatus_Success"
                       sourceRef="Gateway_AfterGetStatus"
                       targetRef="EndEvent_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        <![CDATA[${statusFound == true}]]>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_GetStatus_Error"
                       sourceRef="Gateway_AfterGetStatus"
                       targetRef="ErrorEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        <![CDATA[${statusFound == false}]]>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:extensionElements>
        <camunda:executionListener event="end"
                                   class="com.example.sbp.listener.PaymentStatusListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GetStatus_Success</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="ErrorEndEvent">
      <bpmn:extensionElements>
        <camunda:executionListener event="end"
                                   class="com.example.sbp.listener.PaymentStatusListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CheckPrivilege_Error</bpmn:incoming>
      <bpmn:incoming>Flow_GetStatus_Error</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="ProcessError" />
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:error id="ProcessError" errorCode="PROCESS_ERROR" />

</bpmn:definitions>